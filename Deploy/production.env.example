# Copy these names into the secret/environment configuration of the host.
# Do not put real keys in this file or commit them.
FLICK_COORDINATOR_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8090
FLICK_COORDINATOR_PUBLIC_URL=https://matchmaking.example.com
FLICK_COORDINATOR_AUTO_LAUNCH=true
FLICK_SERVER_EXECUTABLE=C:\FLICK\DedicatedServer\WindowsServer\FLICKServer.exe
FLICK_SERVER_PUBLIC_HOST=game-server.example.com
FLICK_SERVER_ENABLE_STEAM=true
FLICK_STEAM_APP_ID=YOUR_STEAM_APP_ID
FLICK_STEAM_WEB_API_KEY=YOUR_PUBLISHER_WEB_API_KEY
FLICK_STEAM_TICKET_IDENTITY=FLICK
FLICK_COORDINATOR_FIRST_PORT=7780
FLICK_COORDINATOR_STARTUP_TIMEOUT=45
FLICK_COORDINATOR_HEARTBEAT_TIMEOUT=20
FLICK_COORDINATOR_SUPERVISION_INTERVAL=2
FLICK_SERVER_CREDENTIAL_LIFETIME=7200
FLICK_COORDINATOR_RECONNECT_GRACE=45
FLICK_COORDINATOR_MMR_GAP=350
